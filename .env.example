# Copy this file to `.env.local` for local development.
# Never commit a real `.env`/`.env.local` file — only this example file with
# placeholders should ever be committed.

# ---------------------------------------------------------------------------
# Ask page (GitHub Copilot integration)
# ---------------------------------------------------------------------------
# Required for the Ask page to call the real GitHub Copilot chat-completions
# API via the official `@copilot-extensions/preview-sdk`. Without this token
# (or GITHUB_TOKEN below), the Ask page falls back to a deterministic,
# extractive answer built directly from the grounding articles — it will
# never silently call a different/unrelated chat API and never fabricate a
# "live" response.
#
# The token must be authorized to call https://api.githubcopilot.com and is
# typically a Copilot-enabled GitHub App/OAuth token (the kind issued to
# GitHub Copilot Chat/Extensions integrations), NOT a generic PAT with no
# Copilot access. Keep this secret server-side only (used from Route
# Handlers / server code — never exposed via NEXT_PUBLIC_*).
COPILOT_API_TOKEN=

# Optional fallback token if COPILOT_API_TOKEN is not set. Only useful if the
# token happens to carry Copilot API access; a normal `GITHUB_TOKEN` from CI
# will NOT work for this purpose.
GITHUB_TOKEN=

# Optional: override the chat model used for the Ask page (default: gpt-4o).
COPILOT_API_MODEL=gpt-4o

# Optional: override the Copilot chat-completions endpoint (default:
# https://api.githubcopilot.com/chat/completions). Only change this if you
# are pointing at a compatible proxy/gateway.
# COPILOT_API_ENDPOINT=https://api.githubcopilot.com/chat/completions

# ---------------------------------------------------------------------------
# Ingestion (news + resource metadata scripts)
# ---------------------------------------------------------------------------
# Optional. When set, `npm run ingest` and `npm run ingest:resources` send an
# authenticated Authorization header to api.github.com, raising the rate
# limit from 60 to 5,000 requests/hour and reducing flakiness in CI. A
# fine-grained PAT with no extra scopes (public read-only access) is enough;
# in GitHub Actions the built-in `${{ secrets.GITHUB_TOKEN }}` is sufficient
# and requires no extra setup.
# GITHUB_TOKEN=
